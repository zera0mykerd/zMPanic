<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0000">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FF0033"
                android:textSize="18sp"
                android:textStyle="bold" />
            <Space android:layout_width="match_parent" android:layout_height="20dp" />
            <FrameLayout
                android:id="@+id/btnSosContainer"
                android:layout_width="150dp"
                android:layout_height="150dp">
                <View
                    android:id="@+id/glowEffect"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent" />
                <LinearLayout
                    android:id="@+id/btnStopSos"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:clickable="true"
                    android:elevation="10dp"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_stop"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_hold"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp" />
                </LinearLayout>
            </FrameLayout>
            <Space android:layout_width="match_parent" android:layout_height="20dp" />
            <FrameLayout
                android:id="@+id/cameraContainer"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="#000000">
                <TextureView
                    android:id="@+id/textureView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
            <Space android:layout_width="match_parent" android:layout_height="20dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:orientation="vertical"
                android:padding="15dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/title_system_settings"
                    android:textColor="#FF0033"
                    android:textSize="12sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/editIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_server_ip"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#88FFFFFF"
                    android:singleLine="true"/>
                <EditText
                    android:id="@+id/editPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_server_password"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#88FFFFFF"
                    android:singleLine="true"
                    android:inputType="textPassword"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/editPort"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_port"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#88FFFFFF"
                        android:singleLine="true"/>
                    <EditText
                        android:id="@+id/editSecs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_secs"
                        android:inputType="number"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#88FFFFFF"
                        android:singleLine="true"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_front_camera"
                        android:textColor="#FFFFFF" />
                    <Switch
                        android:id="@+id/switchFront"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
            <Button
                android:id="@+id/btnDownloadServer"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="180dp"
                android:layout_height="25dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_download_button"
                android:elevation="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/btn_download_server"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
    <View
        android:id="@+id/hiddenOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />
</FrameLayout>